@using System.ComponentModel.DataAnnotations
@using ElectronicMedicalRecord.Models
@using ElectronicMedicalRecord.Services
@inject PatientService patientService

<div class="overlay" role="presentation" @onclick="Close">
    <div class="overlay-container px-3" @onclick:stopPropagation="true">
        <section class="standard-card w-100" style="max-width: 760px; max-height: calc(100vh - 64px); overflow-y: auto;" role="dialog" aria-modal="true" aria-labelledby="patient-dialog-title">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <p class="text-uppercase small fw-semibold mb-1" style="color: var(--info-color);">
                        @(IsCreating ? "New record" : $"Patient #{Patient.Id}")
                    </p>
                    <h2 id="patient-dialog-title" class="h3 mb-0">@(IsCreating ? "Create New Patient" : FullName(Patient))</h2>
                </div>
                <button class="btn-close" type="button" aria-label="Close patient dialog" @onclick="Close"></button>
            </div>

            <EditForm Model="Patient" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert" />

                <fieldset disabled="@(!IsCreating && Patient.IsDisabled)">
                    <legend class="h5">Demographics</legend>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="first-name">First name</label>
                            <InputText id="first-name" class="form-control" @bind-Value="Patient.FirstName" />
                            <ValidationMessage For="@(() => Patient.FirstName)" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="middle-name">Middle name</label>
                            <InputText id="middle-name" class="form-control" @bind-Value="Patient.MiddleName" />
                            <ValidationMessage For="@(() => Patient.MiddleName)" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="last-name">Last name</label>
                            <InputText id="last-name" class="form-control" @bind-Value="Patient.LastName" />
                            <ValidationMessage For="@(() => Patient.LastName)" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="date-of-birth">Date of birth</label>
                            <InputDate id="date-of-birth" class="form-control" @bind-Value="Patient.DateOfBirth" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="phone-number">Phone number</label>
                            <InputText id="phone-number" class="form-control" @bind-Value="Patient.PhoneNumber" />
                            <ValidationMessage For="@(() => Patient.PhoneNumber)" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="email">Email</label>
                            <InputText id="email" type="email" class="form-control" @bind-Value="Patient.Email" />
                            <ValidationMessage For="@(() => Patient.Email)" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="address">Address</label>
                            <InputText id="address" class="form-control" @bind-Value="Patient.Address" />
                            <ValidationMessage For="@(() => Patient.Address)" />
                        </div>
                    </div>

                    

                    <div class="border-top pt-4 mb-4">
                        <h3 class="h5">Medical Overview</h3>
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-4">
                                <div class="small text-muted">Record ID</div>
                                <div class="fw-semibold">@(MedicalRecord.Id == 0 ? "Not saved" : MedicalRecord.Id)</div>
                            </div>
                            <div class="col-12 col-sm-4">
                                <div class="small text-muted">Patient ID</div>
                                <div class="fw-semibold">@MedicalRecord.PatientId</div>
                            </div>
                            <div class="col-12 col-sm-4">
                                <div class="small text-muted">Medications</div>
                                <div class="fw-semibold">@MedicalRecord.Medications.Count</div>
                            </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-12 col-md-4">
                                        <label class="form-label" for="blood-type">Blood type</label>
                                        <InputText id="blood-type" class="form-control"
                                                   @bind-Value="MedicalRecord.BloodType" />
                                        <ValidationMessage For="@(() => MedicalRecord.BloodType)" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label" for="height">Height</label>
                                        <InputText id="height" class="form-control" placeholder="e.g. 170 cm"
                                                   @bind-Value="MedicalRecord.Height" />
                                        <ValidationMessage For="@(() => MedicalRecord.Height)" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label" for="weight">Weight</label>
                                        <InputText id="weight" class="form-control" placeholder="e.g. 70 kg"
                                                   @bind-Value="MedicalRecord.Weight" />
                                        <ValidationMessage For="@(() => MedicalRecord.Weight)" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="primary-concern">Primary healthcare concern</label>
                                        <InputTextArea id="primary-concern" class="form-control"
                                                       @bind-Value="MedicalRecord.PrimaryHealthcareConcern" />
                                        <ValidationMessage For="@(() => MedicalRecord.PrimaryHealthcareConcern)" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="allergies">Allergies</label>
                                        <InputTextArea id="allergies" class="form-control"
                                                       placeholder="List known allergies or enter None"
                                                       @bind-Value="MedicalRecord.Allergies" />
                                        <ValidationMessage For="@(() => MedicalRecord.Allergies)" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Medications</label>
                                        <InputText @bind-Value="selectedMedication.name" class="form-control mb-2" />
                                        <button class="btn btn-primary" @onclick="UpdateMedication">Add Medication</button>
                                    </div>
                                    <ul class="list-group list-group-flush">
                                        @foreach (var medication in MedicalRecord.Medications)
                                        {
                                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                                <span>@medication.name</span><button class="btn btn-sm btn-outline-danger" type="button"
                                                                                        @onclick="() => RemoveMedication(medication)">Remove</button></li>
                                            <li class="list-group-item px-0">@medication</li>
                                        }
                                    </ul>
                                </div>
                        </div>
                            
                    </div>
                </fieldset>

                @if (!IsCreating && Patient.IsDisabled)
                {
                    <div class="alert mb-4" role="status">This patient is disabled and cannot be edited.</div>
                    <button class="btn btn-primary" type="button" @onclick="Enable">Enable Patient</button>
                }

                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div>
                        @if (!IsCreating && !Patient.IsDisabled)
                        {
                            <button class="btn btn-danger" type="button" @onclick="Disable">Disable Patient</button>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary" type="button" @onclick="Close">Cancel</button>
                        @if (IsCreating || !Patient.IsDisabled)
                        {
                            <button class="btn btn-primary" type="submit">@(IsCreating ? "Create Patient" : "Save Changes")</button>
                        }
                    </div>
                </div>
            </EditForm>
        </section>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Patient Patient { get; set; } = new();

    [Parameter, EditorRequired]
    public Medical MedicalRecord { get; set; } = new();
    public Medication selectedMedication { get; set; } = new();

    [Parameter]
    public bool IsCreating { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<Patient> OnSave { get; set; }

    [Parameter]
    public EventCallback<Patient> OnDisable { get; set; }

    [Parameter]
    public EventCallback<Patient> OnEnable { get; set; }

    private Task Close() => OnClose.InvokeAsync();

    private Task Save() => OnSave.InvokeAsync(Patient);

    private async Task Disable()
    {
        await OnDisable.InvokeAsync(Patient);
        Patient.IsDisabled = true;
    } 

    private async Task Enable()
    {
        await OnEnable.InvokeAsync(Patient);
        Patient.IsDisabled = false;
    } 

    private static string FullName(Patient patient) =>
        $"{patient.FirstName} {patient.MiddleName} {patient.LastName}".Replace("  ", " ").Trim();

    private async Task RemoveMedication(Medication medication)
    {
        try
        {
            await patientService.UpdatePatient(Patient);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not remove medication. Ex: {ex}");

        }
    }

    private async Task UpdateMedication()
    {
        try
        {
            Patient.MedicalOverview!.Medications.Add(selectedMedication);
            await patientService.UpdatePatient(Patient);
            selectedMedication = new();
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Could not add medication. Ex: {ex}");
        }
    }

}
