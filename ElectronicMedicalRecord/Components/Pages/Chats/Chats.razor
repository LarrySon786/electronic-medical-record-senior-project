@page "/messages"

@using System.Net
@using ElectronicMedicalRecord.Models
@using Microsoft.AspNetCore.SignalR.Client
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject CookieProvider cookieProvider

@inject AuthenticationStateProvider authStateProvider
@inject ElectronicMedicalRecord.Services.EmployeeService employeeService
@inject ElectronicMedicalRecord.Services.MessageService messageService

@implements IAsyncDisposable

<div class="chat-layout d-flex border rounded overflow-hidden bg-white">

    @* LEFT: chat list *@
    <aside class="chat-sidebar d-flex flex-column border-end bg-light">
        <div class="p-2 border-bottom">
            <button type="button" class="btn btn-primary w-100" @onclick="() => showModal = true">+ New chat</button>
        </div>

        <div class="list-group list-group-flush overflow-auto flex-grow-1">
            @if (chats is null)
            {
                <p class="text-muted text-center m-auto p-3">Loading...</p>
            }
            else if (!chats.Any())
            {
                <p class="text-muted text-center m-auto p-3">No chats yet.</p>
            }
            else
            {
                @foreach (var chat in chats)
                {
                    <button type="button"
                            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(chat.Id == chatId ? "active" : "")"
                            @onclick="() => OnSelectedChat(chat.Id)">
                        <span>@chat.CreateAt.ToLocalTime().ToString("g")</span>
                        <span class="badge bg-secondary rounded-pill">@chat.Messages.Count</span>
                    </button>
                }
            }
        </div>
    </aside>

    @* RIGHT: conversation *@
    <section class="chat-main d-flex flex-column flex-grow-1">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger rounded-0 mb-0 py-2">@errorMessage</div>
        }

        <div class="flex-grow-1 overflow-auto p-3 d-flex flex-column gap-2">
            @if (chatId == 0)
            {
                <p class="text-muted text-center m-auto">Select a chat</p>
            }
            else if (!messages.Any())
            {
                <p class="text-muted text-center m-auto">No messages yet.</p>
            }
            else
            {
                @foreach (Message m in messages)
                {
                    bool mine = m.EmployeeId == currentEmployeeId;

                    <div class="d-flex flex-column @(mine ? "align-items-end" : "align-items-start")">
                        <div class="chat-bubble px-3 py-2 rounded-4 @(mine ? "bg-primary text-white" : "bg-light border")">
                            @m.Content
                        </div>
                        <small class="text-muted">@m.SendAt.ToLocalTime().ToString("t")</small>
                    </div>
                }
            }
        </div>

        @if (chatId != 0)
        {
            <form class="d-flex gap-2 p-2 border-top" @onsubmit="SendMessage" @onsubmit:preventDefault>
                <input type="text" class="form-control" placeholder="Type a message..." @bind="text"
                       @bind:event="oninput" />
                <button type="submit" class="btn btn-primary px-4" disabled="@string.IsNullOrWhiteSpace(text)">Send</button>
            </form>
        }
    </section>
</div>
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New chat</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModal"></button>
                </div>
                <form @onsubmit="CreateChat" @onsubmit:preventDefault>
                    <div class="modal-body">
                        <label class="form-label">First message</label>
                        <input type="text" class="form-control" maxlength="100" @bind="newChatMessage"
                               @bind:event="oninput" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary"
                                disabled="@string.IsNullOrWhiteSpace(newChatMessage)">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private HubConnection? hubConnection;
    private List<Message> messages = new();
    private List<Chat>? chats;
    private string newChatMessage = "";
    private string text = "";
    private string errorMessage = "";
    private int chatId;
    private int currentEmployeeId;

    private bool showModal;

    protected override async Task OnInitializedAsync()
    {
        var authState = await authStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (userId is null)
        {
            errorMessage = "User not authenticated.";
            return;
        }

        var employee = await employeeService.GetEmployeeByUserIdAsync(userId);
        if (employee is null)
        {
            errorMessage = "Employee not found.";
            return;
        }

        currentEmployeeId = employee.Id;

        //Get All chats
        chats = await messageService.GetAllChatsAsync();

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            //If not cookie set
            if (string.IsNullOrEmpty(cookieProvider.Value)) return;

            // Set connection to Chathub
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/chathub"), options =>
                {
                    options.Cookies.Add(new Cookie("EMR.Identity", cookieProvider.Value)
                    {
                        Domain = Navigation.ToAbsoluteUri("/").Host,
                        Path = "/"
                    });
                })
                .Build();

            // Listen for message receive from Hub and display it
            hubConnection.On<int, int, int, string, DateTime>("ReceiveMessage",
                (messageId, msgChatId, employeeId, content, sendAt) =>
            {

                Console.WriteLine($"Message: {content} sended for chat: {chatId}");
                Message newMessage = new()
                {
                    Id = messageId,
                    Content = content,
                    SendAt = sendAt,
                    EmployeeId = employeeId,
                    ChatId = msgChatId
                };
                InvokeAsync(() => { if (msgChatId == chatId) messages.Add(newMessage); StateHasChanged(); });
            });

            hubConnection.On("ChatCreated", async () =>
            {
                chats = await messageService.GetAllChatsAsync(); //reload list
                await InvokeAsync(StateHasChanged);

            });

            try
            {
                //start connection
                await hubConnection.StartAsync();
            }
            catch (Exception)
            {
                errorMessage = "Chat unavailable";
                StateHasChanged();
            }

        }
    }

    private async Task OnSelectedChat(int id)
    {
        chatId = id;
        if (hubConnection is not null)
        {
            try
            {
                await hubConnection.InvokeAsync("JoinChat", chatId);
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
        }
        messages = await messageService.GetMessageByChatIdAsync(chatId);
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(text)) return;

        if (hubConnection is not null)
        {
            try
            {
                await hubConnection.SendAsync("SendMessageAsync", chatId, text);
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }

        }
        text = "";
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private async Task CreateChat()
    {
        if (string.IsNullOrEmpty(newChatMessage)) return;

        if (hubConnection?.State != HubConnectionState.Connected)
        {
            errorMessage = "Chat unavailable";
            return;
        }

        try
        {
            int newChatId = await hubConnection.InvokeAsync<int>("CreateChat", newChatMessage);
            CloseModal();
            await OnSelectedChat(newChatId); // open the new chat right away
        }
        catch (Exception)
        {
            errorMessage = "Could not create the chat.";
        }

       
    }

    private void CloseModal()
    {
        showModal = false;
        newChatMessage = "";
    }
}