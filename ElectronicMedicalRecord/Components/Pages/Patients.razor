@page "/patients"
@rendermode InteractiveServer
@using ElectronicMedicalRecord.Database
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ProjectDatabaseConnection> DbContextFactory

<PageTitle>Patients</PageTitle>

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-uppercase small fw-semibold mb-1" style="color: var(--info-color);">Patient records</p>
            <h1 class="mb-1">Patients</h1>
            <p class="mb-0 text-muted">Search and select a patient to view their record.</p>
        </div>
        <button class="btn btn-primary" type="button" @onclick="OpenCreateDialog">
            <span aria-hidden="true">+</span> Create New Patient
        </button>
    </div>

    <div class="standard-card">
        <div class="row align-items-end g-3 mb-4">
            <div class="col-12 col-md-7 col-lg-5">
                <label class="form-label fw-semibold" for="patient-search">Search patients</label>
                <input id="patient-search" class="form-control" type="search"
                           placeholder="Search by name, date of birth, phone, or email"
                       @bind="SearchTerm" @bind:event="oninput" />
            </div>
            <div class="col-auto ms-md-auto text-muted small">
                @FilteredPatients.Count patient@(FilteredPatients.Count == 1 ? "" : "s") shown
            </div>
        </div>

        @if (FilteredPatients.Count == 0)
        {
            <div class="info" role="status">
                No patients match your search.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Patient</th>
                            <th scope="col">Country</th>
                            <th scope="col">Date of birth</th>
                            <th scope="col">Phone</th>
                            <th scope="col">Email</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in FilteredPatients)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@FullName(patient)</div>
                                    <div class="small text-muted">Patient #@patient.Id</div>
                                </td>
                                <td>@CountryFor(patient)</td>
                                <td>@patient.DateOfBirth.ToString("MMM d, yyyy")</td>
                                <td>@patient.PhoneNumber</td>
                                <td>@patient.Email</td>
                                <td>
                                    @if (patient.IsDisabled)
                                    {
                                        <span class="badge text-bg-secondary">Disabled</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-secondary" type="button" @onclick="() => OpenPatientDialog(patient)">
                                        View patient
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (IsDialogOpen)
{
    <PatientDialog Patient="ActivePatient"
                   MedicalRecord="ActiveMedicalRecord"
                   IsCreating="IsCreating"
                   OnClose="CloseDialog"
                   OnSave="SavePatient"
                   OnDisable="DisablePatient" />
}

@code {
    private string SearchTerm { get; set; } = "";
    private bool IsDialogOpen { get; set; }
    private bool IsCreating { get; set; }
    private Patient ActivePatient { get; set; } = new();
    private Medical ActiveMedicalRecord { get; set; } = new();
    private bool DatabaseAvailable { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadPatientsAsync();
    }

    private async Task LoadPatientsAsync()
    {
        try
        {
            await using var context = await DbContextFactory.CreateDbContextAsync();
            PatientsList = await context.Patients
                .AsNoTracking()
                .OrderBy(patient => patient.LastName)
                .ThenBy(patient => patient.FirstName)
                .ToListAsync();
            DatabaseAvailable = true;
        }
        catch (Exception)
        {
            DatabaseAvailable = false;
            if (PatientsList.Count == 0)
            {
                PatientsList = CreateDemoPatients();
            }
        }
    }

    private List<Patient> PatientsList { get; set; } = [];

    private List<Patient> FilteredPatients => PatientsList
        .Where(patient => string.IsNullOrWhiteSpace(SearchTerm)
            || FullName(patient).Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
            || patient.PhoneNumber.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
            || patient.Email.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
            || patient.DateOfBirth.ToString("yyyy-MM-dd").Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
            || patient.DateOfBirth.ToString("MMM d, yyyy").Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private static string CountryFor(Patient patient) => patient.Id switch
    {
        1001 => "Canada",
        1002 => "Japan",
        1003 => "Spain",
        1004 => "United Kingdom",
        1005 => "Australia",
        1006 => "United States",
        1007 => "South Africa",
        1008 => "Brazil",
        1009 => "Germany",
        1010 => "France",
        1011 => "Italy",
        1012 => "Netherlands",
        1013 => "Sweden",
        1014 => "India",
        _ => "Unknown"
    };

    private async Task OpenPatientDialog(Patient patient)
    {
        ActivePatient = CopyPatient(patient);
        if (DatabaseAvailable)
        {
            await using var context = await DbContextFactory.CreateDbContextAsync();
            ActiveMedicalRecord = await context.MedicalRecords
                .AsNoTracking()
                .Include(record => record.Medications)
                .FirstOrDefaultAsync(record => record.PatientId == patient.Id)
                ?? CreateMedicalRecord(patient);
        }
        else
        {
            ActiveMedicalRecord = CreateMedicalRecord(patient);
        }
        IsCreating = false;
        IsDialogOpen = true;
    }

    private void OpenCreateDialog()
    {
        ActivePatient = new Patient { DateOfBirth = DateTime.Today.AddYears(-18) };
        ActiveMedicalRecord = new Medical();
        IsCreating = true;
        IsDialogOpen = true;
    }

    private void CloseDialog()
    {
        IsDialogOpen = false;
    }

    private async Task SavePatient(Patient patient)
    {
        if (!DatabaseAvailable)
        {
            if (IsCreating)
            {
                patient.Id = PatientsList.Count == 0 ? 1001 : PatientsList.Max(existing => existing.Id) + 1;
                PatientsList.Add(patient);
            }
            else
            {
                var existing = PatientsList.FirstOrDefault(existing => existing.Id == patient.Id);
                if (existing is not null) PatientsList[PatientsList.IndexOf(existing)] = patient;
            }

            IsDialogOpen = false;
            return;
        }

        await using var context = await DbContextFactory.CreateDbContextAsync();
        if (IsCreating)
        {
            context.Patients.Add(patient);
            ActiveMedicalRecord.Patient = patient;
            context.MedicalRecords.Add(ActiveMedicalRecord);
        }
        else
        {
            context.Patients.Update(patient);
            var medical = await context.MedicalRecords.Include(record => record.Medications).FirstOrDefaultAsync(record => record.PatientId == patient.Id);
            if (medical is null) context.MedicalRecords.Add(ActiveMedicalRecord);
            else
            {
                medical.BloodType = ActiveMedicalRecord.BloodType;
                medical.Height = ActiveMedicalRecord.Height;
                medical.Weight = ActiveMedicalRecord.Weight;
                medical.PrimaryHealthcareConcern = ActiveMedicalRecord.PrimaryHealthcareConcern;
                medical.Allergies = ActiveMedicalRecord.Allergies;
                context.Medications.RemoveRange(medical.Medications);
                medical.Medications = ActiveMedicalRecord.Medications;
            }
        }

        await context.SaveChangesAsync();
        await LoadPatientsAsync();
        IsDialogOpen = false;
    }

    private async Task DisablePatient(Patient patient)
    {
        if (!DatabaseAvailable)
        {
            patient.IsDisabled = true;
            var existing = PatientsList.FirstOrDefault(existing => existing.Id == patient.Id);
            if (existing is not null) PatientsList[PatientsList.IndexOf(existing)] = patient;
            IsDialogOpen = false;
            return;
        }

        await using var context = await DbContextFactory.CreateDbContextAsync();
        patient.IsDisabled = true;
        context.Patients.Update(patient);
        await context.SaveChangesAsync();
        await LoadPatientsAsync();
        IsDialogOpen = false;
    }

    private static string FullName(Patient patient) =>
        $"{patient.FirstName} {patient.MiddleName} {patient.LastName}".Replace("  ", " ").Trim();

    private static Medical CreateMedicalRecord(Patient patient) => new()
    {
        PatientId = patient.Id,
        Patient = patient,
        BloodType = "Unknown",
        Height = "",
        Weight = "",
        PrimaryHealthcareConcern = "",
        Allergies = "None recorded",
        Medications = new List<Medication>()
    };

    private static Patient CopyPatient(Patient patient) => new()
    {
        Id = patient.Id,
        FirstName = patient.FirstName,
        MiddleName = patient.MiddleName,
        LastName = patient.LastName,
        PhoneNumber = patient.PhoneNumber,
        Email = patient.Email,
        Address = patient.Address,
        DateOfBirth = patient.DateOfBirth,
        IsDisabled = patient.IsDisabled
    };

