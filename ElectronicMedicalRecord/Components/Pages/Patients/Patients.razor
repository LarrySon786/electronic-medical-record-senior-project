@page "/patients"
@rendermode InteractiveServer
@attribute [Authorize]
@using ElectronicMedicalRecord.Components.Ui
@using ElectronicMedicalRecord.Models
@using ElectronicMedicalRecord.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inject ElectronicMedicalRecord.Services.PatientService patientService
@inject ChartService chartService

<PageTitle>Patients</PageTitle>

<div class="container-fluid px-4 py-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-uppercase small fw-semibold mb-1" style="color: var(--info-color);">Patient records</p>
            <h1 class="mb-1">Patients</h1>
            <p class="mb-0 text-muted">Search and select a patient to view their record.</p>
        </div>
        <button class="btn btn-primary" type="button" @onclick="OpenCreateDialog">
            <span aria-hidden="true">+</span> Create New Patient
        </button>
    </div>

    <div class="standard-card">
        <div class="row align-items-end g-3 mb-4">
            <div class="col-12 col-md-7 col-lg-5">
                <label class="form-label fw-semibold" for="patient-search">Search patients</label>
                <input id="patient-search" class="form-control" type="search"
                       placeholder="Search by name, phone, or email"
                       @bind="SearchTerm" @bind:event="oninput" />
            </div>
            <div class="col-auto ms-md-auto text-muted small">
                @FilteredPatients.Count patient@(FilteredPatients.Count == 1 ? "" : "s") shown
            </div>
        </div>

        @if (FilteredPatients.Count == 0)
        {
            <div class="info" role="status">
                No patients match your search.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Patient</th>
                            @* <th scope="col">Country</th> *@
                            <th scope="col">Date of birth</th>
                            <th scope="col">Phone</th>
                            <th scope="col">Email</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in FilteredPatients)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@FullName(patient)</div>
                                    <div class="small text-muted">Patient #@patient.Id</div>
                                </td>
                                @* <td>@CountryFor(patient)</td> *@
                                <td>@patient.DateOfBirth.ToString("MMM d, yyyy")</td>
                                <td>@patient.PhoneNumber</td>
                                <td>@patient.Email</td>
                                <td>
                                    @if (patient.IsDisabled)
                                    {
                                        <span class="badge text-bg-secondary">Disabled</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-secondary" type="button" @onclick="() => OpenPatientDialog(patient)">
                                        View patient
                                    </button>
                                    <button class="btn btn-sm btn-secondary" type="button"
                                            @onclick="() => OpenChartDialog(patient.Id)">
                                        View Charts        
                                    </button>
                                    <AuthorizeView Roles="Practitioner">
                                        <Authorized>
                                            <button class="btn btn-sm btn-primary" type="button"
                                                    @onclick="() => CreateChart(patient.Id)">
                                                Create Chart
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (IsDialogOpen)
{
    <PatientDialog Patient="ActivePatient"
                   IsCreating="IsCreating"
                   OnClose="CloseDialog"
                   OnSave="SavePatient"
                   OnDisable="DisablePatient"
                   OnEnable="EnablePatient" />
}
else if (ViewChartsDialog)
{
    <ChartingHistoryDialog Charts="selectedCharts" OnClose="CloseChartDialog"/>
}

@code {
    private List<Chart> selectedCharts { get; set; } = new();
    private bool ViewChartsDialog { get; set; } = false;
    private string SearchTerm { get; set; } = "";
    private bool IsDialogOpen { get; set; }
    private bool IsCreating { get; set; }
    private string error { get; set; } = string.Empty;
    private Patient ActivePatient { get; set; } = new();
    private Medical ActiveMedicalRecord { get; set; } = new();

    private List<Patient> PatientsList { get; set; } = new();

    private List<Patient> FilteredPatients => PatientsList
        .Where(patient => string.IsNullOrWhiteSpace(SearchTerm)
            || FullName(patient).Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
            || patient.PhoneNumber.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
            || patient.Email.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await RefreshPatients();
    }

    private void OpenPatientDialog(Patient patient)
    {
        ActivePatient = patient;
        ActiveMedicalRecord = CreateMedicalRecord(patient);
        IsCreating = false;
        IsDialogOpen = true;
    }

    private void OpenCreateDialog()
    {
        ActivePatient = new Patient { DateOfBirth = DateOnly.FromDateTime(DateTime.Today.AddYears(-18)) };
        ActiveMedicalRecord = new Medical();
        IsCreating = true;
        IsDialogOpen = true;
    }


    private void CloseDialog()
    {
        IsDialogOpen = false;
    }

    private async Task SavePatient(Patient patient)
    {
        try
        {
            @* Save new patient *@
            if (IsCreating)
            {
                await patientService.CreatePatient(patient);
                await RefreshPatients();
            }

            @* Update existing patient *@
            else
            {
                await patientService.UpdatePatient(patient);
                await RefreshPatients();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Patient creation failed. Ex: {ex}");
            error = "Failed to create new patient.";
        }

        @* Close dialog *@
        IsDialogOpen = false;
    }

    private async Task DisablePatient(Patient patient)
    {
        try
        {
            await patientService.TogglePatientDisable(patient.Id);
            await RefreshPatients();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Patient disable failed. Ex: {ex}");
            error = "Failed to disable patient.";
        }
    }

    private async Task EnablePatient(Patient patient)
    {
        try
        {
            await patientService.TogglePatientDisable(patient.Id);
            await RefreshPatients();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Patient enable failed. Ex: {ex}");
            error = "Failed to enable patient.";
        }
    }

    private static string FullName(Patient patient) =>
        $"{patient.FirstName} {patient.MiddleName} {patient.LastName}".Replace("  ", " ").Trim();

    private static Medical CreateMedicalRecord(Patient patient) => new()
    {
        PatientId = patient.Id,
        Patient = patient,
        Medications = new List<Medication>()
    };


    @* This function creates a new chart note and redirects to a new charting page *@
    private async Task CreateChart(int patientId)
    {
        try
        {
            Employee? user = await authState.GetCurrentUserAsync();
            if (user == null) return;
            Chart? newChart = await chartService.CreateNewChart(patientId, user.Id);
            navigationManager.NavigateTo($"/patient/chart/{newChart.Id}");
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Could not create a new chart. Ex: {ex}");
        }
    }

    @* This function allows employees to view existing charts for patients. *@

    private async Task OpenChartDialog(int patientId)
    {
        try
        {
            selectedCharts = await chartService.GetAllChartsByPatientId(patientId);
            ViewChartsDialog = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not fetch patient's charts. Ex: {ex}");
        }

    }

    private void CloseChartDialog()
    {
        ViewChartsDialog = false;
        selectedCharts = new();
    }

    @* This function created a new datbase query to refresh the page with fresh content *@
    private async Task RefreshPatients()
    {
        try
        {
            PatientsList = await patientService.GetAllPatients();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not fetch list of patients. Ex: {ex}");
            error = "Could not find patients. Please try again.";
        }
    }

    private void ClearMessages()
    {
        error = "";
    }
}
