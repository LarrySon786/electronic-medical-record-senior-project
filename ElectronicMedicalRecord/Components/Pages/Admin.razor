@page "/admin"

<PageTitle>Admin Settings</PageTitle>

<div class="container-fluid px-4 py-4">
    <div class="mb-4">
        <p class="text-uppercase small fw-semibold mb-1" style="color: var(--info-color);">Administration</p>
        <h1 class="mb-1">Admin Settings</h1>
        <p class="mb-0 text-muted">Manage clinic access and administrative settings.</p>
    </div>
    <div class="standard-card">
        <h2 class="h4">Employee access</h2>
        <p class="text-muted">Create and edit clinic employee accounts, contact details, roles, and access status.</p>
        <NavLink class="btn btn-primary" href="/admin/employees">Open Employee Management</NavLink>
    </div>
</div>