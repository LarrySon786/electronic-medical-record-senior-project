@page "/admin/employees"
@rendermode InteractiveServer
@using ElectronicMedicalRecord.Models
@using ElectronicMedicalRecord.Models.Dtos
@inject ElectronicMedicalRecord.Services.EmployeeService employeeServices
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Employee Management</PageTitle>

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-uppercase small fw-semibold mb-1" style="color: var(--info-color);">
                Administration
            </p>

            <h1 class="mb-1">Employee Management</h1>

            <p class="mb-0 text-muted">
                Manage everyone who has access to the medical clinic.
            </p>
        </div>

        <button class="btn btn-primary" type="button" @onclick="OpenCreateDialog">
            + Create New Employee
        </button>
    </div>

    <div class="standard-card">
        <div class="row align-items-end g-3 mb-4">
            <div class="col-12 col-md-7 col-lg-5">
                <label class="form-label fw-semibold" for="employee-search">
                    Search employees
                </label>

                <input id="employee-search" class="form-control" type="search"
                       placeholder="Search by name, role, or email" @bind="SearchTerm" @bind:event="oninput" />
            </div>

            <div class="col-auto ms-md-auto text-muted small">
                @FilteredEmployees.Count employee@(FilteredEmployees.Count == 1 ? "" : "s") shown
            </div>
        </div>

        @if (FilteredEmployees.Count == 0)
        {
            <div class="info" role="status">
                No employees match your search.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Contact</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>
                                <span class="visually-hidden">Actions</span>
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var employee in FilteredEmployees)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @FullName(employee)
                                    </div>

                                    <div class="small text-muted">
                                        Employee #@employee.Id
                                    </div>
                                </td>

                                <td>
                                    <div>
                                        @employee.ApplicationUser.Email
                                    </div>

                                    <div class="small text-muted">
                                        @employee.PhoneNumber
                                    </div>
                                </td>

                                <td>
                                    <span class="badge text-bg-info">
                                        @employee.Role
                                    </span>
                                </td>

                                <td>
                                    @(employee.IsDisabled ? "Disabled" : "Active")
                                </td>

                                <td class="text-end">
                                    <button class="btn btn-sm btn-secondary" type="button"
                                            @onclick="() => OpenEditDialog(employee)">
                                        Edit employee
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (IsDialogOpen)
{
    <div class="overlay" role="presentation" @onclick="CloseDialog">

        <div class="overlay-container" role="dialog" aria-modal="true" aria-labelledby="employee-dialog-title"
             @onclick:stopPropagation="true">

            <div class="standard-card w-100 mx-3" style="max-width: 760px; max-height: 90vh; overflow-y: auto;">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 id="employee-dialog-title" class="h4 mb-0">
                        @(IsCreating ? "Create New Employee" : "Edit Employee")
                    </h2>

                    <button class="btn-close" type="button" aria-label="Close" @onclick="CloseDialog">
                    </button>
                </div>

                <EditForm Model="ActiveEmployee" OnValidSubmit="SaveEmployee" FormName="SaveEmployee">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="first-name">
                                First name
                            </label>

                            <InputText id="first-name" class="form-control" @bind-Value="ActiveEmployee.FirstName" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" for="middle-name">
                                Middle name
                            </label>

                            <InputText id="middle-name" class="form-control" @bind-Value="ActiveEmployee.MiddleName" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" for="last-name">
                                Last name
                            </label>

                            <InputText id="last-name" class="form-control" @bind-Value="ActiveEmployee.LastName" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="phone">
                                Phone number
                            </label>

                            <InputText id="phone" class="form-control" @bind-Value="ActiveEmployee.PhoneNumber" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="email">
                                Email
                            </label>

                            <InputText id="email" type="email" class="form-control" @bind-Value="ActiveEmployee.ApplicationUser.Email" />
                        </div>



                        <div class="col-md-4">
                            <label class="form-label" for="birth-date">
                                Date of birth
                            </label>

                            <InputDate id="birth-date" class="form-control" @bind-Value="ActiveEmployee.DateOfBirth" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" for="role">
                                Role
                            </label>

                            <InputSelect id="role" class="form-select" @bind-Value="ActiveEmployee.Role">

                                <option value="@EmployeeRole.Employee">
                                    Employee
                                </option>

                                <option value="@EmployeeRole.Practitioner">
                                    Practitioner
                                </option>

                                <option value="@EmployeeRole.Admin">
                                    Admin
                                </option>
                            </InputSelect>
                        </div>

                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <InputCheckbox id="disabled" class="form-check-input"
                                               @bind-Value="ActiveEmployee.IsDisabled" />

                                <label class="form-check-label" for="disabled">
                                    Disable login
                                </label>
                            </div>
                        </div>


                        @if (IsCreating)
                        {
                            <div class="col-12">
                                <label class="form-label" for="password">
                                    @(IsCreating ? "Initial password" : "Password")
                                </label>

                                <InputText id="password" type="password" class="form-control"
                                        @bind-Value="InitialPassword" />

                                <div class="form-text">
                                    For now, the admin provides this password to the employee.
                                    Email setup can be added later.
                                </div>
                            </div>
                        }
                        
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button class="btn btn-secondary" type="button" @onclick="CloseDialog">
                            Cancel
                        </button>

                        <button class="btn btn-primary" type="submit">
                            Save employee
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private string SearchTerm { get; set; } = "";

    private bool IsDialogOpen { get; set; }

    private bool IsCreating { get; set; }

    private Employee ActiveEmployee { get; set; } = new();
    private string InitialPassword { get; set; } = string.Empty;

    private List<Employee> Employees { get; set; } = new();

    private List<Employee> FilteredEmployees =>
        Employees
            .Where(employee =>
                string.IsNullOrWhiteSpace(SearchTerm) ||
                $"{FullName(employee)} {employee.ApplicationUser.Email} {employee.Role}"
                    .Contains(
                        SearchTerm,
                        StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await RefreshEmployees();
    }

    private static string FullName(Employee employee) =>
        string.Join(
            " ",
            new[]
            {
                employee.FirstName,
                employee.MiddleName,
                employee.LastName
            }
            .Where(value => !string.IsNullOrWhiteSpace(value)));

    private void OpenCreateDialog()
    {
        IsCreating = true;
        ActiveEmployee = new Employee();
        var ApplicationUser = new ApplicationUser();
        ActiveEmployee.ApplicationUser = ApplicationUser;
        InitialPassword = string.Empty;
        IsDialogOpen = true;
    }

    private void OpenEditDialog(Employee employee)
    {
        IsCreating = false;

        ActiveEmployee = new Employee
        {
            Id = employee.Id,
            FirstName = employee.FirstName,
            MiddleName = employee.MiddleName,
            LastName = employee.LastName,
            PhoneNumber = employee.PhoneNumber,
            ApplicationUser = employee.ApplicationUser,
            DateOfBirth = employee.DateOfBirth,
            Role = employee.Role,
            IsDisabled = employee.IsDisabled
        };

        IsDialogOpen = true;
    }

    private void CloseDialog()
    {
        IsDialogOpen = false;
    }
    private async Task SaveEmployee()
    {
        try
        {
            if (IsCreating)
            {
                await employeeServices.CreateEmployeeAsync(ActiveEmployee, InitialPassword);
            }
            else if (!IsCreating)
            {
                await employeeServices.UpdateEmployeeAsync(ActiveEmployee);
            }
            await RefreshEmployees();
            CloseDialog();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not create or save existing employee. Ex: {ex}");
        }
    }

    private async Task RefreshEmployees()
    {
        try
        {
            Employees = await employeeServices.GetAllEmployeesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not refresh list of employees. Ex: {ex}");
        }
    }

    private async Task DisableEmployee()
    {
        await employeeServices.ToggleEmployeeDisable(ActiveEmployee.Id);
    }
    private async Task EnableEmployee()
    {
        await employeeServices.ToggleEmployeeDisable(ActiveEmployee.Id);
    }
}
